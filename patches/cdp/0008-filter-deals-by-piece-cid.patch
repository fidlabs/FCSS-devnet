+  private async prepareDealPieceCreations(
+    logs: Logs,
+  ): Promise<PrismaPromise<unknown>[]> {
+    const dealCreatedLogs = logs
+      .filter((log) => {
+        return isAddressEqual(
+          log.address,
+          this.configService.get('PO_REP_MARKET_CONTRACT_ADDRESS'),
+        );
+      })
+      .filter((log) => {
+        return log.eventName === 'DealCreated';
+      });
+
+    if (dealCreatedLogs.length === 0) {
+      return [];
+    }
+
+    const pieceRows: DealPieceCreationInput[] = [];
+    for (const log of dealCreatedLogs) {
+      const pieceCids = await this.fetchManifestPieceCids(
+        log.args.manifestLocation,
+      );
+      for (const pieceCid of pieceCids) {
+        pieceRows.push({
+          dealId: log.args.dealId,
+          pieceCid,
+        });
+      }
+    }
+
+    if (pieceRows.length === 0) {
+      return [];
+    }
+
+    return [
+      this.prismaService.po_rep_deal_piece.createMany({
+        data: pieceRows,
+        skipDuplicates: true,
+      }),
+    ];
+  }
+
+  private async prepareDealPieceRefreshes(
+    logs: Logs,
+  ): Promise<PrismaPromise<unknown>[]> {
+    const manifestUpdatedLogs = logs
+      .filter((log): log is PoRepMarketLog => {
+        return (
+          isAddressEqual(
+            log.address,
+            this.configService.get('PO_REP_MARKET_CONTRACT_ADDRESS'),
+          ) && log.eventName === 'ManifestLocationUpdated'
+        );
+      })
+      .filter((log) => log.eventName === 'ManifestLocationUpdated');
+
+    if (manifestUpdatedLogs.length === 0) {
+      return [];
+    }
+
+    // Last update per deal wins.
+    const latestByDeal = new Map<
+      string,
+      { dealId: bigint; manifestLocation: string }
+    >();
+    for (const log of manifestUpdatedLogs) {
+      if (log.eventName !== 'ManifestLocationUpdated') {
+        continue;
+      }
+      latestByDeal.set(log.args.dealId.toString(), {
+        dealId: log.args.dealId,
+        manifestLocation: log.args.newManifestLocation,
+      });
+    }
+
+    const ops: PrismaPromise<unknown>[] = [];
+    for (const { dealId, manifestLocation } of latestByDeal.values()) {
+      const pieceCids = await this.fetchManifestPieceCids(manifestLocation);
+      ops.push(
+        this.prismaService.po_rep_deal_piece.deleteMany({
+          where: { dealId },
+        }),
+      );
+      if (pieceCids.length > 0) {
+        ops.push(
+          this.prismaService.po_rep_deal_piece.createMany({
+            data: pieceCids.map((pieceCid) => ({ dealId, pieceCid })),
+            skipDuplicates: true,
+          }),
+        );
+      }
+    }
+
+    return ops;
+  }
+
+  private async fetchManifestPieceCids(
+    manifestLocation: string,
+  ): Promise<string[]> {
+    try {
+      const response = await fetch(manifestLocation, {
+        signal: AbortSignal.timeout(15_000),
+      });
+      if (!response.ok) {
+        throw new Error(`HTTP ${response.status} ${response.statusText}`);
+      }
+
+      const json: unknown = await response.json();
+      const root = Array.isArray(json) ? json[0] : json;
+      const pieces =
+        root &&
+        typeof root === 'object' &&
+        'pieces' in root &&
+        Array.isArray((root as { pieces: unknown }).pieces)
+          ? (root as { pieces: unknown[] }).pieces
+          : [];
+
+      const pieceCids = pieces
+        .map((piece) => {
+          if (
+            piece &&
+            typeof piece === 'object' &&
+            'pieceCid' in piece &&
+            typeof (piece as { pieceCid: unknown }).pieceCid === 'string'
+          ) {
+            return (piece as { pieceCid: string }).pieceCid.trim();
+          }
+          return '';
+        })
+        .filter((pieceCid) => pieceCid.length > 0);
+
+      return [...new Set(pieceCids)];
+    } catch (error) {
+      this.logger.warn(
+        `Failed to index piece CIDs from manifest ${manifestLocation}: ${
+          error instanceof Error ? error.message : String(error)
+        }`,
+      );
+      return [];
+    }
+  }
