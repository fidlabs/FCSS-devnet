+
+# @title Deal Type
+# @notice Gapped deal type codes (see porep-market DealType.sol).
+class PoRepMarketDealType(enum.Enum):
+    NONE = 0
+    PUBLIC = 10
+    PRIVATE = 20
+
+    def __str__(self):
+        return self.name
+
+    def __repr__(self):
+        return self.name
+
+    @staticmethod
+    def to_string_list():
+        return [t.name for t in PoRepMarketDealType if t is not PoRepMarketDealType.NONE]
+
+    @staticmethod
+    def from_web3(s: str | int | None) -> "PoRepMarketDealType":
+        if s is None or s == "":
+            raise ValueError(f"Invalid deal type: {s}")
+
+        raw = str(s).strip().lower()
+        if raw in ("0", "none"):
+            return PoRepMarketDealType.NONE
+        if raw in ("10", "public"):
+            return PoRepMarketDealType.PUBLIC
+        if raw in ("20", "private"):
+            return PoRepMarketDealType.PRIVATE
+        raise ValueError(f"Invalid deal type: {s}")
+
+
